{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JazonraeB/aidus/schema/event.schema.json",
  "title": "AIDUS 1.1 usage event",
  "description": "One line of .ai-usage/events/YYYY-MM/<writer_id>.jsonl. Cross-field rules (disjoint buckets, reasoning <= output, total_tokens, credential scan) are in spec/AIDUS.md §4.2 and §9 and are not expressible in JSON Schema.",
  "type": "object",
  "required": ["schema_version", "usage_id", "project_id", "timestamp", "recorded_at", "writer_id", "source", "provider", "model"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "usage_id": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+:[A-Za-z0-9._:-]+$" },
    "project_id": { "$ref": "#/$defs/project_id" },
    "timestamp": { "$ref": "#/$defs/datetime" },
    "recorded_at": { "$ref": "#/$defs/datetime" },
    "writer_id": { "$ref": "#/$defs/writer_id" },
    "source": { "enum": ["coding-agent", "provider-api", "provider-billing", "local-log", "manual-import", "ide-integration", "cli-integration"] },
    "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "agent": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "agent_version": { "type": ["string", "null"], "maxLength": 64 },
    "session_id": { "type": ["string", "null"], "maxLength": 128 },
    "subagent": { "type": ["boolean", "null"] },

    "input_tokens": { "$ref": "#/$defs/tokens" },
    "cache_read_tokens": { "$ref": "#/$defs/tokens" },
    "cache_write_5m_tokens": { "$ref": "#/$defs/tokens" },
    "cache_write_1h_tokens": { "$ref": "#/$defs/tokens" },
    "cache_write_tokens": { "$ref": "#/$defs/tokens" },
    "output_tokens": { "$ref": "#/$defs/tokens" },
    "reasoning_tokens": { "$ref": "#/$defs/tokens" },
    "total_tokens": { "$ref": "#/$defs/tokens" },

    "speed": { "type": ["string", "null"], "maxLength": 32 },
    "inference_geo": { "type": ["string", "null"], "maxLength": 32 },
    "service_tier": { "type": ["string", "null"], "maxLength": 32 },
    "batch": { "type": ["boolean", "null"] },
    "server_tool_requests": {
      "type": ["object", "null"],
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },

    "branch": { "type": ["string", "null"], "maxLength": 255 },
    "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
    "feature_id": { "type": ["string", "null"], "pattern": "^FEAT-[0-9]+$" },
    "developer": { "type": ["string", "null"], "pattern": "^hmac-sha256:[0-9a-f]{64}$" },
    "notes": { "type": ["string", "null"], "maxLength": 200 },

    "cost": {
      "type": ["object", "null"],
      "required": ["amount_micros", "currency", "cost_status"],
      "properties": {
        "amount_micros": { "type": ["integer", "null"], "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "cost_status": { "enum": ["authoritative", "calculated", "estimated", "unknown"] },
        "pricing_source": { "type": ["string", "null"], "maxLength": 64 },
        "pricing_version": { "type": ["string", "null"], "maxLength": 32 }
      },
      "additionalProperties": false,
      "if": { "properties": { "cost_status": { "const": "unknown" } } },
      "then": { "properties": { "amount_micros": { "type": "null" } } }
    }
  },
  "patternProperties": {
    "^x-[a-z0-9-]+$": {}
  },
  "additionalProperties": false,
  "$defs": {
    "tokens": { "type": ["integer", "null"], "minimum": 0 },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{6,126}[a-z0-9]$" },
    "writer_id": { "type": "string", "pattern": "^[a-z0-9]{8,32}$" }
  }
}
