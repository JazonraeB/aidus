    "total_mismatch": "total_tokens != sum of buckets excluding reasoning (§4.2)",
    "cache_write_overlap": "cache_write_tokens set together with a split cache-write bucket (§4.2)",
    "timestamp_after_recorded_at": "timestamp more than 5 minutes after recorded_at (§4.1)",
    "credential_pattern": "A string value matches a credential pattern (§9)",
    "duplicate_conflict": "Same usage_id and recorded_at with different values (§6)"
  },
